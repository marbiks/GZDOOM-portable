# Development leftovers
dev/__pycache__/
*.pyc
__pycache__/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Extracted engine build inputs (regenerate with the tools/ scripts)
engine/uzdoom-src/
engine/gzdoom414-src/
engine/gzdoom.js
engine/gzdoom.wasm
engine/*.pk3

# Workspace metadata (not part of the project)
.freebuff/

