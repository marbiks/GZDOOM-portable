screenshots/
*.png.tmp

# Game data is never part of this project (neither commercial nor free IWADs)
*.wad
*.WAD
*.pk3
*.PK3
*.ipk3
*.IPK3
wads/

# Local save archives and user data (never commit these)
backups/*.zip
saves/*.zip
config/*.ini

# Local override of the launcher's own preferences export
GZDoom-Portable-Saves-*.zip
